---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import MainLayout from '../../layouts/main.astro';

const allTeam = await getCollection('team');
---

<MainLayout
  title="تیم ما"
  description="آشنایی با متخصصین و پژوهشگران تیم ویهان در حوزه‌های هوش مصنوعی، امنیت شبکه و سیستم‌های نهفته."
>
  <section class="py-16 md:py-24">
    <div class="container mx-auto px-4 md:px-8">

      <div class="mb-16 max-w-2xl">
        <h1 class="font-heading text-4xl md:text-5xl font-bold text-foreground mb-6">متخصصین واقعی،<br/><span class="text-primary">راه‌حل‌های مهندسی.</span></h1>
        <p class="text-lg text-muted-foreground leading-relaxed">
          ما یک تیم از توسعه‌دهندگان و پژوهشگران (PhD) هستیم که دانش آکادمیک را با تجربه مهندسی سطح پایین ترکیب کرده‌ایم.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {allTeam.map((member: CollectionEntry<'team'>) => (
          <a href={`/team/${member.id}`} class="group flex flex-col p-6 md:p-8 rounded-xl border border-border bg-card shadow-sm hover:shadow-md hover:border-primary/50 transition-all">

            <div class="mb-6 pb-6 border-b border-border/50">
              <h2 class="font-heading text-2xl font-bold text-foreground mb-1 group-hover:text-primary transition-colors">
                {member.data.name}
              </h2>
              <p class="text-primary font-medium text-sm">
                {member.data.role}
              </p>
            </div>

            <div class="mb-6 flex-1">
              <span class="text-sm font-bold text-foreground block mb-3">حوزه‌های تمرکز:</span>
              <div class="flex flex-wrap gap-2">
                {member.data.specialties.map((specialty: string) => (
                  <span class="inline-flex items-center px-2.5 py-1 rounded-md bg-secondary/10 text-secondary text-xs font-medium border border-secondary/20">
                    {specialty}
                  </span>
                ))}
              </div>
            </div>

            <div class="mt-auto pt-4 border-t border-border/40 flex items-center text-sm font-medium text-foreground group-hover:text-primary transition-colors">
              مشاهده پروفایل کامل
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="rotate-180 mr-2"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
            </div>

          </a>
        ))}
      </div>

    </div>
  </section>
</MainLayout>
