---
// src/pages/about.astro
import MainLayout from '../layouts/main.astro';
import { aboutHeader, aboutStory, aboutPhilosophy } from '../data/about';
---

<MainLayout
  title="درباره ما"
  description={aboutHeader.description}
>
  <div class="relative bg-background overflow-hidden">

    <header class="relative pt-32 pb-20 md:pt-40 md:pb-28 overflow-hidden">
      <div class="absolute inset-0 bg-grid-pattern opacity-30 dark:opacity-10"></div>
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-primary/10 blur-[100px] rounded-full pointer-events-none"></div>

      <div class="container mx-auto px-4 md:px-8 relative z-10 text-center max-w-4xl">
        <h1 class="font-heading text-4xl md:text-5xl lg:text-6xl font-extrabold text-foreground mb-6 leading-tight tracking-tight">
          {aboutHeader.titlePart1} <br/>
          <span class="text-gradient-copper">{aboutHeader.titleHighlight}</span>
        </h1>
        <p class="text-xl text-muted-foreground leading-relaxed max-w-3xl mx-auto">
          {aboutHeader.description}
        </p>
      </div>
    </header>

    <div class="container mx-auto px-4 md:px-8 pb-32">

      <section class="glass-panel rounded-[2.5rem] p-8 md:p-12 lg:p-16 mb-24 border-border/40 relative overflow-hidden">
        <div class="absolute -bottom-32 -left-32 w-96 h-96 bg-primary/10 blur-[80px] rounded-full pointer-events-none"></div>

        <div class="flex flex-col lg:flex-row gap-12 items-center relative z-10">
          <div class="lg:w-1/2 space-y-6">
            <h2 class="text-foreground font-heading text-3xl md:text-4xl font-bold mb-6">
              {aboutStory.titleStart} <span class="text-primary">{aboutStory.titleHighlight}</span>
            </h2>
            {aboutStory.paragraphs.map(paragraph => (
              <p class="text-lg text-muted-foreground leading-relaxed">{paragraph}</p>
            ))}
          </div>

          <div class="lg:w-1/2 w-full">
            <div class="relative w-full aspect-[4/3] rounded-3xl overflow-hidden border border-border/30 shadow-2xl">
              <img
                src={aboutStory.image}
                alt="داستان شکل‌گیری"
                class="w-full h-full object-cover"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-tr from-background/80 via-background/20 to-transparent mix-blend-multiply dark:mix-blend-overlay"></div>
            </div>
          </div>
        </div>
      </section>

      <section>
        <div class="text-center mb-16">
          <h2 class="text-foreground font-heading text-3xl md:text-4xl font-bold mb-4">
            {aboutPhilosophy.titleStart} <span class="text-gradient-copper">{aboutPhilosophy.titleHighlight}</span> {aboutPhilosophy.titleEnd}
          </h2>
          <p class="text-muted-foreground text-lg">{aboutPhilosophy.subtitle}</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
          {aboutPhilosophy.items.map(item => (
            <div class="glass-panel p-8 rounded-3xl border-border/40 hover:border-primary/40 transition-all duration-300 hover:-translate-y-1">
              <div class={`w-12 h-12 rounded-xl bg-${item.colorClass}/20 text-${item.colorClass} flex items-center justify-center mb-6 border border-${item.colorClass}/20`} set:html={item.icon} />
              <h3 class="font-heading text-2xl font-bold text-foreground mb-3">{item.title}</h3>
              <p class="text-muted-foreground leading-relaxed">
                {item.description}
              </p>
            </div>
          ))}
        </div>
      </section>

    </div>
  </div>
</MainLayout>
