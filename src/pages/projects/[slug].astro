---
// src/pages/projects/[slug].astro
import { getCollection, render } from 'astro:content';
import MainLayout from '../../layouts/main.astro';

// تغییر slug به id برای سازگاری با Astro 5
export async function getStaticPaths() {
  const projectEntries = await getCollection('projects');
  return projectEntries.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
// روش جدید رندر کردن محتوا در Astro 5
const { Content } = await render(entry);

const formattedDate = entry.data.publishDate
  ? new Intl.DateTimeFormat('fa-IR', { year: 'numeric', month: 'long' }).format(entry.data.publishDate)
  : '';
---

<MainLayout
  title={entry.data.title}
  description={entry.data.problem}
>
  <article class="py-16 md:py-24">
    <div class="container mx-auto px-4 md:px-8 max-w-4xl">

      <header class="mb-12 border-b border-border pb-10">
        <div class="flex items-center gap-4 mb-6">
          <span class="inline-block px-3 py-1 rounded-full bg-secondary text-secondary-foreground text-sm font-bold">
            {entry.data.category}
          </span>
          {formattedDate && (
            <span class="text-sm text-muted-foreground">{formattedDate}</span>
          )}
        </div>
        <h1 class="font-heading text-3xl md:text-5xl font-bold text-foreground leading-[1.3] mb-8">
          {entry.data.title}
        </h1>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 bg-muted/30 p-6 md:p-8 rounded-xl border border-border/50">
          <div>
            <h3 class="text-lg font-bold text-foreground mb-2 flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-destructive"></span> چالش اصلی
            </h3>
            <p class="text-muted-foreground text-sm leading-relaxed">{entry.data.problem}</p>
          </div>
          <div>
            <h3 class="text-lg font-bold text-foreground mb-2 flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-primary"></span> راه‌حل ویهان
            </h3>
            <p class="text-muted-foreground text-sm leading-relaxed">{entry.data.solution}</p>
          </div>
          <div class="md:col-span-2 pt-4 border-t border-border/40">
            <h3 class="text-lg font-bold text-foreground mb-2 flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-success"></span> دستاورد و نتیجه
            </h3>
            <p class="text-foreground font-medium leading-relaxed">{entry.data.result}</p>
          </div>
        </div>
      </header>

      <div class="prose prose-lg prose-zinc dark:prose-invert max-w-none text-muted-foreground leading-loose">
        <Content />
      </div>

      <div class="mt-16 pt-8 border-t border-border">
        <a href="/projects" class="inline-flex items-center gap-2 text-primary font-medium hover:underline underline-offset-4">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg>
          بازگشت به لیست پروژه‌ها
        </a>
      </div>

    </div>
  </article>
</MainLayout>
