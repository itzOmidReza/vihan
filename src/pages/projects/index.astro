---
// src/pages/projects/index.astro
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import MainLayout from '../../layouts/main.astro';

const allProjects = await getCollection('projects');

const sortedProjects = allProjects.sort((a: CollectionEntry<'projects'>, b: CollectionEntry<'projects'>) => {
  const dateA = a.data.publishDate ? new Date(a.data.publishDate).getTime() : 0;
  const dateB = b.data.publishDate ? new Date(b.data.publishDate).getTime() : 0;
  return dateB - dateA;
});
---

<MainLayout
  title="پروژه‌های واقعی"
  description="بررسی کیس‌استادی‌ها و راه‌حل‌های مهندسی تیم ویهان در حوزه‌های هوش مصنوعی، امنیت شبکه و سیستم‌های نهفته."
>
  <div class="relative bg-background overflow-hidden min-h-screen">

    {/* هدر صفحه */}
    <header class="relative pt-32 pb-20 md:pt-40 md:pb-24 overflow-hidden">
      <div class="absolute inset-0 bg-grid-pattern opacity-30 dark:opacity-10"></div>
      <div class="absolute top-0 right-1/4 w-[600px] h-[300px] bg-primary/10 blur-[100px] rounded-full pointer-events-none"></div>

      <div class="container mx-auto px-4 md:px-8 relative z-10 text-center max-w-3xl">
        <h1 class="font-heading text-4xl md:text-5xl lg:text-6xl font-extrabold text-foreground mb-6 tracking-tight">
          پروژه‌های <span class="text-gradient-copper">صنعتی</span> و واقعی
        </h1>
        <p class="text-lg text-muted-foreground leading-relaxed">
          ما روی چالش‌هایی کار می‌کنیم که نیازمند معماری اختصاصی هستند. در اینجا می‌توانید صورت مسئله، راه‌حل فنی ویهان و نتایج ملموس هر پروژه را بررسی کنید.
        </p>
      </div>
    </header>

    {/* لیست پروژه‌ها */}
    <section class="container mx-auto px-4 md:px-8 pb-32 relative z-10">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {sortedProjects.map((project: CollectionEntry<'projects'>) => (
          <a href={`/projects/${project.id}`} class="group glass-panel rounded-3xl p-8 md:p-10 flex flex-col justify-between border-border/40 hover:border-primary/50 transition-all duration-500 hover:-translate-y-2 hover:shadow-[0_20px_40px_-15px_rgba(198,108,49,0.15)] relative overflow-hidden">

            {/* هاله نوری هاور */}
            <div class="absolute -bottom-20 -right-20 w-64 h-64 bg-primary/5 blur-[60px] rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>

            <div class="relative z-10">
              <div class="mb-6">
                <span class="inline-flex items-center px-4 py-1.5 rounded-full bg-secondary/50 backdrop-blur-md text-secondary-foreground text-xs font-bold mb-4 border border-border/50">
                  <span class="w-1.5 h-1.5 rounded-full bg-primary mr-2"></span>
                  {project.data.category}
                </span>
                <h2 class="font-heading text-2xl md:text-3xl font-bold text-foreground group-hover:text-primary transition-colors leading-tight">
                  {project.data.title}
                </h2>
              </div>

              <div class="space-y-5 mt-8 border-t border-border/30 pt-6">
                <div>
                  <span class="text-xs font-bold uppercase tracking-wider text-muted-foreground block mb-2">صورت مسئله:</span>
                  <p class="text-foreground/80 text-sm leading-relaxed">{project.data.problem}</p>
                </div>
                <div>
                  <span class="text-xs font-bold uppercase tracking-wider text-primary block mb-2">دستاورد نهایی:</span>
                  <p class="text-foreground font-medium text-sm leading-relaxed">{project.data.result}</p>
                </div>
              </div>
            </div>

            <div class="relative z-10 mt-10 pt-6 border-t border-border/30 flex items-center text-sm font-bold text-foreground group-hover:text-primary transition-colors">
              مطالعه کامل کیس‌استادی
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="rotate-180 mr-2 group-hover:-translate-x-1 transition-transform"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
            </div>

          </a>
        ))}
      </div>
    </section>
  </div>
</MainLayout>
