---
// src/pages/projects/index.astro
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import MainLayout from '../../layouts/main.astro';

// خواندن تمام پروژه‌ها از کالکشن
const allProjects = await getCollection('projects');

// مرتب‌سازی بر اساس تاریخ (جدیدترین به قدیمی‌ترین) در صورت وجود تاریخ
const sortedProjects = allProjects.sort((a: CollectionEntry<'projects'>, b: CollectionEntry<'projects'>) => {
  const dateA = a.data.publishDate ? new Date(a.data.publishDate).getTime() : 0;
  const dateB = b.data.publishDate ? new Date(b.data.publishDate).getTime() : 0;
  return dateB - dateA;
});
---

<MainLayout
  title="پروژه‌های واقعی"
  description="بررسی کیس‌استادی‌ها و راه‌حل‌های مهندسی تیم ویهان در حوزه‌های هوش مصنوعی، امنیت شبکه و سیستم‌های نهفته."
>
  <section class="py-16 md:py-24">
    <div class="container mx-auto px-4 md:px-8">

      <div class="mb-12 md:mb-16 max-w-2xl">
        <h1 class="font-heading text-4xl md:text-5xl font-bold text-foreground mb-4">پروژه‌های واقعی ما</h1>
        <p class="text-lg text-muted-foreground">
          ما روی چالش‌های واقعی کار می‌کنیم. در اینجا می‌توانید معماری مشکل، راه‌حل فنی ویهان و نتایج ملموس هر پروژه را بررسی کنید.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-8">
        {sortedProjects.map((project: CollectionEntry<'projects'>) => (
          <a href={`/projects/${project.id}`} class="group flex flex-col justify-between p-6 md:p-8 rounded-xl border border-border bg-card hover:border-primary/50 transition-all shadow-sm hover:shadow-md">

            <div>
              <div class="mb-4">
                <span class="inline-block px-3 py-1 rounded-full bg-secondary/10 text-secondary text-xs font-bold mb-3 border border-secondary/20">
                  {project.data.category}
                </span>
                <h2 class="font-heading text-2xl font-bold text-foreground group-hover:text-primary transition-colors">
                  {project.data.title}
                </h2>
              </div>

              <div class="space-y-4 mt-6">
                <div>
                  <span class="text-sm font-bold text-foreground block mb-1">مسئله:</span>
                  <p class="text-muted-foreground text-sm leading-relaxed">{project.data.problem}</p>
                </div>
                <div>
                  <span class="text-sm font-bold text-foreground block mb-1">نتیجه:</span>
                  <p class="text-primary font-medium text-sm leading-relaxed">{project.data.result}</p>
                </div>
              </div>
            </div>

            <div class="mt-8 pt-4 border-t border-border/40 flex items-center text-sm font-medium text-foreground group-hover:text-primary transition-colors">
              مطالعه کامل کیس‌استادی
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="rotate-180 mr-2"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
            </div>

          </a>
        ))}
      </div>

    </div>
  </section>
</MainLayout>
