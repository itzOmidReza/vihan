---
// src/pages/services.astro
import MainLayout from '../layouts/main.astro';
import { servicesHeader, servicesList } from '../data/services';
---

<MainLayout
  title="خدمات تخصصی"
  description={servicesHeader.description}
>
  <div class="relative bg-background overflow-hidden">

    <header class="relative pt-32 pb-20 md:pt-40 md:pb-28 overflow-hidden">
      <div class="absolute inset-0 bg-grid-pattern opacity-30 dark:opacity-10"></div>
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-primary/10 blur-[100px] rounded-full pointer-events-none"></div>

      <div class="container mx-auto px-4 md:px-8 relative z-10 text-center max-w-3xl">
        <h1 class="font-heading text-5xl md:text-6xl font-extrabold text-foreground mb-6 leading-tight">
          {servicesHeader.titleStart} <span class="text-gradient-copper">{servicesHeader.titleHighlight}</span> {servicesHeader.titleEnd}
        </h1>
        <p class="text-xl text-muted-foreground leading-relaxed">
          {servicesHeader.description}
        </p>
      </div>
    </header>

    <div class="container mx-auto px-4 md:px-8 pb-24 space-y-24 md:space-y-32">
      {servicesList.map((service, index) => (
        <section id={service.id} class="scroll-mt-32 group">
          <div class={`flex flex-col gap-8 md:gap-16 ${index % 2 !== 0 ? 'md:flex-row-reverse' : 'md:flex-row'} items-center`}>

            <div class="w-full md:w-1/2">
              <div class="glass-panel p-8 md:p-12 rounded-[2.5rem] relative overflow-hidden border-border/40 hover:border-primary/40 transition-colors duration-500">
                <div class="absolute -top-20 -right-20 w-40 h-40 bg-primary/10 blur-[50px] rounded-full pointer-events-none transition-opacity group-hover:bg-primary/20"></div>

                <div class="relative z-10">
                  <div class="mb-6 inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-secondary/50 backdrop-blur-md text-primary border border-primary/20 shadow-sm" set:html={service.icon} />
                  <h2 class="font-heading text-3xl md:text-4xl font-bold text-foreground mb-3">{service.title}</h2>
                  <h3 class="text-lg font-medium text-primary mb-6">{service.subtitle}</h3>
                  <p class="text-muted-foreground leading-relaxed mb-8 text-lg">
                    {service.description}
                  </p>

                  <div class="space-y-4">
                    <span class="text-sm font-bold text-foreground block mb-4 uppercase tracking-wider">قابلیت‌های کلیدی:</span>
                    <ul class="space-y-4">
                      {service.features.map(feature => (
                        <li class="flex items-start gap-3">
                          <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary mt-0.5 border border-primary/20">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                          </span>
                          <span class="text-foreground/90 font-medium">{feature}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              </div>
            </div>

            <div class="w-full md:w-1/2 relative">
              <div class="relative w-full aspect-[4/3] rounded-[2.5rem] overflow-hidden border border-border/30 shadow-2xl group-hover:shadow-[0_20px_60px_-15px_rgba(198,108,49,0.15)] transition-shadow duration-700">
                <img
                  src={service.image}
                  alt={service.title}
                  class="w-full h-full object-cover scale-105 group-hover:scale-100 transition-transform duration-1000 ease-out opacity-90 dark:opacity-70"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-tr from-background/80 via-background/20 to-transparent mix-blend-multiply dark:mix-blend-overlay"></div>
                <div class="absolute inset-0 border border-white/10 rounded-[2.5rem]"></div>
              </div>
              <div class="absolute -inset-4 bg-primary/5 blur-2xl -z-10 rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>
            </div>

          </div>
        </section>
      ))}
    </div>

  </div>
</MainLayout>
