---
import '@fontsource/vazirmatn/400.css';
import '@fontsource/vazirmatn/700.css';
import '@fontsource/vazirmatn/900.css';
import '../styles/globals.css';

// ایمپورت فایل Astro به‌جای فایل React
import Header from '../components/layout/Header.astro';

interface Props {
	title: string;
    description?: string;
}

const { title, description = "سیستم‌های هوشمند برای مشکلات واقعی" } = Astro.props;
---

<!doctype html>
<html lang="fa" dir="rtl">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | ویهان</title>
	</head>
	<body class="min-h-screen flex flex-col selection:bg-brand-copper selection:text-white">

        {/* فراخوانی کامپوننت هدر */}
		<Header />

        <main class="flex-1">
            <slot />
        </main>
	</body>
</html>
