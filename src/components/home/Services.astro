---
// src/components/home/Services.astro
import { homeServicesData } from '../../data/home';
---

<section class="py-24 relative bg-background overflow-hidden">
  <div class="container mx-auto px-4 md:px-8 relative z-10">

    <div class="mb-16 md:mb-20 text-center max-w-3xl mx-auto">
      <h2 class="font-heading text-4xl md:text-5xl font-bold text-foreground mb-6 tracking-tight">
        {homeServicesData.header.titleStart} <span class="text-gradient-copper">{homeServicesData.header.titleGradient}</span> {homeServicesData.header.titleEnd}
      </h2>
      <p class="text-lg text-muted-foreground leading-relaxed">
        {homeServicesData.header.description}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 auto-rows-[320px]">
      {homeServicesData.items.map(item => (
        <a href={`/services#${item.id}`} class={`group relative overflow-hidden rounded-3xl glass-panel ${item.isLarge ? 'md:col-span-2 p-8 md:p-10 flex flex-col justify-end' : 'p-8 flex flex-col justify-between'} border-border/50 hover:border-primary/50 transition-all duration-300`}>

          {item.isLarge ? (
            <div class="absolute inset-0 z-0 bg-muted">
              <img src={item.image} alt={item.title} class="w-full h-full object-cover opacity-30 dark:opacity-20 group-hover:scale-110 transition-transform duration-1000 ease-out" loading="lazy" />
              <div class="absolute inset-0 bg-gradient-to-t from-background via-background/80 to-transparent"></div>
            </div>
          ) : (
            <div class="absolute -bottom-16 -right-16 w-48 h-48 bg-primary/5 blur-[60px] rounded-full group-hover:bg-primary/20 transition-colors duration-700"></div>
          )}

          <div class="relative z-10 transform transition-transform duration-500 group-hover:-translate-y-2">
            <div class={`inline-flex items-center justify-center rounded-xl bg-secondary/50 text-foreground backdrop-blur-md group-hover:bg-primary/20 group-hover:text-primary transition-colors border border-border/50 ${item.isLarge ? 'h-14 w-14 mb-5' : 'h-12 w-12 mb-auto'}`} set:html={item.icon} />
            <h3 class={`font-heading font-bold text-foreground mb-3 group-hover:text-primary transition-colors ${item.isLarge ? 'text-3xl' : 'text-2xl mt-4'}`}>{item.title}</h3>
            <p class={`text-muted-foreground ${item.isLarge ? 'max-w-lg text-lg' : 'text-sm leading-relaxed'}`}>{item.description}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
