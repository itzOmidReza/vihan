---
// src/components/home/Hero.astro
import { heroData } from '../../data/home';
---

<section class="relative min-h-[90vh] flex items-center justify-center overflow-hidden bg-background py-20">
  <div class="absolute inset-0 z-0">
    <div class="absolute inset-0 bg-grid-pattern opacity-40 dark:opacity-20"></div>
    <div class="absolute left-1/2 top-0 -translate-x-1/2 w-[800px] h-[600px] bg-primary/20 dark:bg-primary/10 blur-[120px] rounded-full pointer-events-none"></div>
  </div>

  <div class="container relative z-10 mx-auto px-4 md:px-8 text-center flex flex-col items-center">
    <div class="glass-panel inline-flex items-center gap-3 rounded-full px-5 py-2 text-sm font-medium text-foreground/80 mb-8 transition-transform hover:scale-105">
      <span class="relative flex h-2.5 w-2.5">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-primary"></span>
      </span>
      {heroData.badge}
    </div>

    <h1 class="font-heading text-5xl sm:text-6xl md:text-7xl lg:text-[5rem] font-extrabold tracking-tight text-foreground mb-8 leading-[1.15] max-w-5xl">
      {heroData.titleLine1} <br class="hidden md:block" />
      <span class="text-gradient-copper">{heroData.titleGradient}</span>
    </h1>

    <p class="max-w-2xl text-lg md:text-xl text-muted-foreground leading-relaxed mb-12">
      {heroData.description}
    </p>

    <div class="flex flex-col sm:flex-row gap-5 w-full sm:w-auto">
      <a href={heroData.primaryCta.link} class="glow-copper inline-flex h-14 items-center justify-center rounded-xl bg-primary px-8 text-base font-bold text-primary-foreground transition-all hover:bg-primary/90 hover:-translate-y-1">
        {heroData.primaryCta.text}
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2 rotate-180"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
      </a>
      <a href={heroData.secondaryCta.link} class="glass-panel inline-flex h-14 items-center justify-center rounded-xl px-8 text-base font-bold text-foreground transition-all hover:bg-muted/50 hover:-translate-y-1">
        {heroData.secondaryCta.text}
      </a>
    </div>
  </div>

  <div class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-background to-transparent z-10 pointer-events-none"></div>
</section>
