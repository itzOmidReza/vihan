---
// src/components/home/Projects.astro
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { homeProjectsData } from '../../data/home';

const allProjects = await getCollection('projects');
const featuredProjects = allProjects.slice(0, 4);
---

<section class="py-24 relative bg-background">
  <div class="container mx-auto px-4 md:px-8 relative z-10">

    <div class="flex flex-col md:flex-row justify-between items-end mb-16 gap-6">
      <div class="max-w-2xl">
        <h2 class="font-heading text-4xl md:text-5xl font-bold text-foreground mb-6">
          {homeProjectsData.header.titleStart} <span class="text-gradient-copper">{homeProjectsData.header.titleGradient}</span>
        </h2>
        <p class="text-lg text-muted-foreground leading-relaxed">
          {homeProjectsData.header.description}
        </p>
      </div>
      <a href={homeProjectsData.cta.link} class="group inline-flex items-center gap-2 text-primary font-bold hover:text-primary-foreground hover:bg-primary px-6 py-3 rounded-xl border border-primary/30 transition-all duration-300">
        {homeProjectsData.cta.text}
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="rotate-180 group-hover:-translate-x-1 transition-transform"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
      {featuredProjects.map((project: CollectionEntry<'projects'>) => (
        <a href={`/projects/${project.id}`} class="group glass-panel rounded-3xl p-8 flex flex-col justify-between border-border/50 hover:border-primary/50 transition-all duration-500 hover:-translate-y-2 hover:shadow-[0_20px_40px_-15px_rgba(198,108,49,0.1)]">
          <div>
            <span class="inline-block px-4 py-1.5 rounded-full bg-secondary/50 backdrop-blur-md text-secondary-foreground text-xs font-bold mb-6 border border-border/50">
              {project.data.category}
            </span>
            <h3 class="font-heading text-2xl font-bold text-foreground mb-4 group-hover:text-primary transition-colors">
              {project.data.title}
            </h3>
            <p class="text-muted-foreground leading-relaxed mb-8 line-clamp-3">
              {project.data.problem}
            </p>
          </div>
          <div class="pt-6 border-t border-border/30 flex items-center text-sm font-bold text-foreground group-hover:text-primary transition-colors">
            مطالعه کیس‌استادی
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="rotate-180 mr-2"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>
